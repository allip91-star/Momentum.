<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="65dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="10dp" android:paddingEnd="9dp"
    android:background="@drawable/widget_row_background">
    <TextView android:id="@+id/widget_color" android:layout_width="5dp"
        android:layout_height="42dp" android:layout_marginEnd="7dp" android:background="#7366E8" />
    <TextView android:id="@+id/widget_emoji" android:layout_width="34dp"
        android:layout_height="wrap_content" android:gravity="center" android:text="✓"
        android:textSize="22sp"/>
    <LinearLayout android:id="@+id/widget_habit_details" android:orientation="vertical"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center_vertical" android:paddingStart="3dp" android:paddingEnd="4dp">
        <TextView android:id="@+id/widget_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
            android:textColor="#1C2240" android:textSize="13sp" android:textStyle="bold"/>
        <TextView android:id="@+id/widget_progress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
            android:layout_marginTop="3dp" android:textColor="#79849A" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_plus" android:layout_width="wrap_content"
        android:minWidth="51dp" android:layout_height="39dp" android:gravity="center"
        android:background="@drawable/widget_button" android:textColor="#FFFFFF" android:textStyle="bold"
        android:paddingStart="9dp" android:paddingEnd="9dp" android:text="+1" android:textSize="12sp"/>
</LinearLayout>
